<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MTN Uganda Prepaid Data Bundles</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f4f4f4;
            color: #222;
            margin: 0;
            padding: 20px;
        }

        h1 {
            text-align: center;
            color: #004f9f;
        }

        
        .table-container {
            max-width: 900px;
            margin: 0 auto;
        }

        table {
            border-collapse: collapse;
            margin: 0 auto;  
            width: 100%;
            background-color: #ffffff;
        }

        caption {
            caption-side: top;
            font-size: 1.2em;
            font-weight: bold;
            padding: 10px;
            color: #004f9f;
        }

        th, td {
            border: 1px solid #555;
            padding: 8px 12px;
            text-align: left;
        }

        thead th {
            background-color: #ffcc00;   
            color: #000;
        }

        tbody tr:nth-child(even) {
            background-color: #eef3fb;
        }

        tbody tr:nth-child(odd) {
            background-color: #ffffff;
        }

        tbody tr:hover {
            background-color: #ffe680;
        }

        .category {
            background-color: #004f9f;
            color: #ffffff;
            font-weight: bold;
            text-align: center;
            vertical-align: middle;
        }

        
        .price {
            text-align: right;
        }

        .best-value {
            display: inline-block;
            margin-left: 6px;
            padding: 2px 6px;
            border-radius: 4px;
            background-color: #2e8b57;
            color: #ffffff;
            font-size: 0.75em;
            font-weight: bold;
        }

        tfoot td {
            background-color: #dddddd;
            font-weight: bold;
            text-align: center;
        }
        @media (max-width: 600px) {
            body {
                padding: 10px;
            }

            .table-container {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            table {
                min-width: 600px;   
            }
        }
    </style>
</head>
<body>
    <h1>MTN Uganda Prepaid Internet Data Bundles</h1>
    <div class="table-container">
        <table>
            <caption>Compare MTN Uganda Prepaid Data Bundles by Validity Period (Prices in UGX)</caption>

            <thead>
                <tr>
                    <th scope="col">Category</th>
                    <th scope="col">Bundle Name</th>
                    <th scope="col">Data Volume</th>
                    <th scope="col">Validity</th>
                    <th scope="col">Price (UGX)</th>
                    <th scope="col">USSD Code</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <th scope="rowgroup" rowspan="3" class="category">Daily</th>
                    <td>Daily Lite</td>
                    <td>100 MB</td>
                    <td>24 Hours</td>
                    <td class="price">500</td>
                    <td>*150*1*1#</td>
                </tr>
                <tr>
                    <td>Daily Plus</td>
                    <td>350 MB</td>
                    <td>24 Hours</td>
                    <td class="price">1,000</td>
                    <td>*150*1*2#</td>
                </tr>
                <tr>
                    <td>Daily Max <span class="best-value">Best Value</span></td>
                    <td>1 GB</td>
                    <td>24 Hours</td>
                    <td class="price">2,000</td>
                    <td>*150*1*3#</td>
                </tr>
                <tr>
                    <th scope="rowgroup" rowspan="3" class="category">Weekly</th>
                    <td>Weekly Lite</td>
                    <td>1 GB</td>
                    <td>7 Days</td>
                    <td class="price">3,500</td>
                    <td>*150*2*1#</td>
                </tr>
                <tr>
                    <td>Weekly Plus</td>
                    <td>2.5 GB</td>
                    <td>7 Days</td>
                    <td class="price">7,000</td>
                    <td>*150*2*2#</td>
                </tr>
                <tr>
                    <td>Weekly Max <span class="best-value">Best Value</span></td>
                    <td>6 GB</td>
                    <td>7 Days</td>
                    <td class="price">15,000</td>
                    <td>*150*2*3#</td>
                </tr>
                <tr>
                    <th scope="rowgroup" rowspan="3" class="category">Monthly</th>
                    <td>Monthly Lite</td>
                    <td>3 GB</td>
                    <td>30 Days</td>
                    <td class="price">10,000</td>
                    <td>*150*3*1#</td>
                </tr>
                <tr>
                    <td>Monthly Plus</td>
                    <td>10 GB</td>
                    <td>30 Days</td>
                    <td class="price">25,000</td>
                    <td>*150*3*2#</td>
                </tr>
                <tr>
                    <td>Monthly Max <span class="best-value">Best Value</span></td>
                    <td>30 GB</td>
                    <td>30 Days</td>
                    <td class="price">50,000</td>
                    <td>*150*3*3#</td>
                </tr>
            </tbody>

            <tfoot>
                <tr>
                    <td colspan="6">Total number of bundles listed: 9</td>
                </tr>
            </tfoot>
        </table>
    </div>

</body>
</html>
